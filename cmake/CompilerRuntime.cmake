include_guard(GLOBAL)

function(anybox_add_compiler_runtime target)
    if(NOT MINGW OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        return()
    endif()
    if(NOT TARGET anybox_compiler_runtime)
        get_filename_component(compilerDirectory "${CMAKE_CXX_COMPILER}" DIRECTORY)
        add_custom_target(anybox_compiler_runtime COMMAND "${CMAKE_COMMAND}" -E make_directory "${ANYBOX_RUNTIME_DIRECTORY}" VERBATIM)
        set(runtimes libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll)
        if(EXISTS "${compilerDirectory}/libssp-0.dll")
            list(APPEND runtimes libssp-0.dll)
        endif()
        foreach(runtime IN LISTS runtimes)
            set(runtimePath "${compilerDirectory}/${runtime}")
            if(NOT IS_ABSOLUTE "${runtimePath}" OR NOT EXISTS "${runtimePath}")
                message(FATAL_ERROR "Required compiler runtime was not found: ${runtime}")
            endif()
            add_custom_command(TARGET anybox_compiler_runtime POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${runtimePath}" "${ANYBOX_RUNTIME_DIRECTORY}" BYPRODUCTS "${ANYBOX_RUNTIME_DIRECTORY}/${runtime}" VERBATIM)
            install(FILES "${runtimePath}" DESTINATION . COMPONENT AnyBoxRuntime)
        endforeach()
    endif()
    add_dependencies(${target} anybox_compiler_runtime)
endfunction()
